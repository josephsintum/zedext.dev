# GitHub (server-only, used by sync script + detail page fetches)
GITHUB_TOKEN=ghp_...

# Search snapshot (Vercel Blob)
# Public URL of extensions.json; the sync prints it. For local dev, the production URL works.
SNAPSHOT_URL=https://xxxxxxxx.public.blob.vercel-storage.com/extensions.json
# Only needed to run the sync (added automatically when a Blob store is linked on Vercel)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Max theme archives the sync downloads per run (default 150). Raise it for a one-off backfill.
PREVIEW_DOWNLOAD_LIMIT=150

# Cron (server-only, used by Vercel cron auth)
CRON_SECRET=replace-with-a-long-random-string

# App
PUBLIC_SITE_URL=https://zedext.dev
